#!/bin/sh
# Pre-commit checks: `make check` (gofmt, build, lint, test).
# Enable with `make hooks`. Bypass once with `git commit --no-verify`.
#
# Checks run against the working tree, not just the staged snapshot,
# so unstaged edits are included.
set -eu

# Only run when Go code, anything it builds from, or a file naming the Go version is staged.
if ! git diff --cached --name-only --diff-filter=ACMR |
	grep -qE '\.go$|^go\.(mod|sum)$|^sql/|^(fly\.toml|docker-compose\.yml|Dockerfile|README\.md|Makefile)$|^scripts/.*\.sh$'; then
	exit 0
fi

fail() {
	echo "pre-commit: $1" >&2
	exit 1
}

command -v golangci-lint >/dev/null 2>&1 ||
	fail "golangci-lint not found; install with (from the repo root): GOTOOLCHAIN=go\$(awk '\$1 == \"go\" { print \$2 }' go.mod) go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0"

# Same checks CI runs before deploying.
make --no-print-directory check || fail "checks failed"
